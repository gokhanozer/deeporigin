    {
      "type": "timeseries",
      "title": "Redirect rate",
      "description": "Short-link resolutions per second. 'not_found' covers unknown, disabled and expired slugs alike.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(shortener_redirect_total[5m]))",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Redirect latency",
      "description": "The number users feel. p99 above 250ms fires RedirectLatencyHigh and is the Phase 3 cache trigger.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(shortener_redirect_duration_seconds_bucket[5m])))",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shortener_redirect_duration_seconds_bucket[5m])))",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(shortener_redirect_duration_seconds_bucket[5m])))",
          "refId": "C",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "gradientMode": "opacity"
