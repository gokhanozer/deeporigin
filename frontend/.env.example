# ---------------------------------------------------------------------------
# Frontend environment.
# Copy to `.env.local` for local development: cp .env.example .env.local
# docker-compose supplies these values itself.
# ---------------------------------------------------------------------------

# API base URL used by BROWSER code. Inlined into the JS bundle at build time,
# so it must be an address the visitor's browser can actually reach.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# API base URL used by SERVER-side code (the [slug] redirect resolver).
# Inside Docker this is the compose service name; locally it matches the above.
API_INTERNAL_URL=http://localhost:4000/api/v1

# Domain shown as the prefix in the custom-slug field before the browser
# reports its own host. Cosmetic only.
NEXT_PUBLIC_SHORT_DOMAIN=localhost:3000
