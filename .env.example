# =============================================================================
# Template for the root `.env` used by docker-compose.
#
#   cp .env.example .env      then edit the values
#
# This file IS committed; `.env` is gitignored. Compose reads `.env` from this
# directory automatically and substitutes ${VAR} references in
# docker-compose.yml at parse time.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# These initialise the Postgres container on first run AND build the backend's
# connection string, so one edit keeps both in step.
#
# NOTE: the password is embedded in a URL (postgresql://user:password@host/db).
# If yours contains any of  @ : / ? # [ ] %  you must percent-encode it there —
# e.g. `p@ss` becomes `p%40ss`. Letters, digits, `!`, `-`, `_`, `.` are safe.
POSTGRES_USER=shortener
POSTGRES_PASSWORD=replace-with-your-password
POSTGRES_DB=shortener

# Port Postgres listens on, inside the container AND published to the host.
# 5433 rather than the usual 5432, to avoid colliding with another local Postgres.
POSTGRES_PORT=5433

# ---- Application secrets ----------------------------------------------------
# Generate real values with: openssl rand -base64 32
# The backend refuses to start in production if these are missing or too short.
JWT_SECRET=replace-with-a-long-random-string
IP_HASH_SALT=replace-with-another-random-string
