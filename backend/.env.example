# ---------------------------------------------------------------------------
# Backend environment.
# Copy to `.env` for local development: cp .env.example .env
# docker-compose supplies these values itself, so no .env file is needed there.
# ---------------------------------------------------------------------------

# ---- Database --------------------------------------------------------------
# Required. Postgres connection string used by Prisma.
#
# Port 5433, not the usual 5432: docker-compose runs Postgres on 5433 (see its
# `command: ['-p', '5433']`) so the same number applies inside the container, on
# the host, and in every connection string — and so it cannot collide with
# another Postgres already using 5432.
#
# The user/password/database must match the POSTGRES_* values in
# docker-compose.yml. Replace the password below with your own before running.
DATABASE_URL="postgresql://gokhanozer:CHANGE_ME@localhost:5433/postgresqldb?schema=public"

# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Origins allowed to call this API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Public base that short links are built from. In production this is the short
# domain itself, e.g. https://short.ly — it is what users copy and share.
PUBLIC_BASE_URL=http://localhost:3000

# ---- Auth ------------------------------------------------------------------
# MUST be replaced in production; the app refuses to boot with a weak value.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d
# bcrypt cost factor. 10 ≈ 100ms per hash; raise for production hardware.
BCRYPT_ROUNDS=10

# ---- Links -----------------------------------------------------------------
# Generated slug length. 7 chars over a 62-char alphabet ≈ 3.5e12 combinations.
SLUG_LENGTH=7
# Retries when a generated slug collides with an existing one.
MAX_SLUG_ATTEMPTS=5

# ---- Privacy ---------------------------------------------------------------
# Salt for hashing visitor IPs. Changing it resets unique-visitor counts.
IP_HASH_SALT=dev-only-ip-salt

# ---- Rate limiting ---------------------------------------------------------
# These are DEFAULTS. Each can be overridden at runtime via a Redis feature
# flag, without a restart — see docs/IMPLEMENTATION.md §10 "Runtime overrides":
#   redis-cli SET ratelimit:override:create '{"limit":2}'
#   redis-cli SET ratelimit:override:auth '{"disabled":true}' EX 600
#   redis-cli DEL ratelimit:override:create
# Sliding window, in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
# General API allowance per window, per client.
RATE_LIMIT_MAX=100
# Link-creation allowance (the abusable write path).
RATE_LIMIT_CREATE_MAX=10
# Auth allowance (brute-force protection).
RATE_LIMIT_AUTH_MAX=5

# ---- Debugging -------------------------------------------------------------
# Set to true to log every SQL statement Prisma issues.
PRISMA_LOG_QUERIES=false

# Direct connection, bypassing any connection pooler (PgBouncer). Required by
# `prisma migrate`, which takes a session-level advisory lock that transaction
# pooling breaks. Locally this is the same as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://shortener:replace-with-your-password@localhost:5433/shortener?schema=public"
